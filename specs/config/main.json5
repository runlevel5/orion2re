{
  // Declaration order is public traversal order. This bootstrap contains only
  // primitive scalar settings already present in the restored game.
  groups: {
    interface: {
      title: "Interface",
      description: "Local presentation, audio, and control settings.",
      save: false,
      synchronize: false,
    },
    gameplay: {
      title: "Gameplay",
      description: "Deterministic gameplay definitions shared by all players.",
      save: true,
      synchronize: true,
    },
  },

  types: {
    // New-game setup domains. These are complete closed sets stored as bytes.
    game_difficulty: {
      title: "Game difficulty",
      description: "Difficulty selected when a new game is created.",
      remarks: "Complete uint8 domain. Numeric configuration preserves the native values 0 through 4.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { tutor: 0, easy: 1, average: 2, hard: 3, impossible: 4 },
    },
    galaxy_age: {
      title: "Galaxy age",
      description: "Stellar age distribution selected for map generation.",
      remarks: "Complete uint8 domain. Numeric configuration preserves the native values 0 through 2.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { young: 0, average: 1, old: 2 },
    },
    galaxy_size: {
      title: "Galaxy size",
      description: "Map-size selection used by new-game setup.",
      remarks: "Complete uint8 domain. Maximum is the extended fifth size and retains native value 4.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { small: 0, medium: 1, large: 2, huge: 3, maximum: 4 },
    },

    // Race and leadership domains. Stock race is a table index, not ownership.
    government: {
      title: "Government",
      description: "A race's base or advanced form of government.",
      remarks: "Complete uint8 semantic-ID domain. The advanced form of each base government has its own native value.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        feudal: 0,
        confederation: 1,
        dictatorship: 2,
        imperium: 3,
        democracy: 4,
        federation: 5,
        unification: 6,
        galactic_unification: 7,
      },
    },
    stock_race_index: {
      title: "Stock race table index",
      description: "Index into the thirteen-entry table of predefined races.",
      remarks: "Complete uint8 index domain. Do not use for player ownership, packed population race data, Androids, natives, or custom-race selections.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        alkari: 0,
        bulrathi: 1,
        darlok: 2,
        elerian: 3,
        gnolam: 4,
        human: 5,
        klackon: 6,
        meklar: 7,
        mrrshan: 8,
        psilon: 9,
        sakkra: 10,
        silicoid: 11,
        trilarian: 12,
      },
    },
    crew_quality: {
      title: "Crew quality",
      description: "Experience rank assigned to a ship's crew.",
      remarks: "Complete uint8 ordered domain from green through ultra elite.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { green: 0, regular: 1, veteran: 2, elite: 3, ultra_elite: 4 },
    },
    leader_type: {
      title: "Leader type",
      description: "Determines whether a leader commands ships or administers colonies.",
      remarks: "Complete uint8 semantic-ID domain. This does not describe leader employment status.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { ship: 0, colony: 1 },
    },

    // Strategic data-table classifications.
    strategic_special_category: {
      title: "Strategic special category",
      description: "AI-oriented category describing the strategic effect of a ship special.",
      remarks: "Complete uint8 semantic-ID domain. Values are categories, not SPECIAL IDs or a bit mask.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        none: 0,
        beam_accuracy: 1,
        beam_damage: 2,
        beam_defense: 3,
        missile_defense: 4,
        missile_damage: 5,
        beam_missile_defense: 6,
        beam_missile_damage: 7,
      },
    },
    technology_application_type: {
      title: "Technology application type",
      description: "Classifies the native object produced by a technology application.",
      remarks: "Complete uint8 semantic-ID domain. Value 6 is reserved and remains valid for native compatibility; this is not the application ai_group field.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        unclassified: { value: 0, description: "No specific application category is assigned." },
        building: { value: 1, description: "The application unlocks a colony building." },
        shield: { value: 2, description: "The application unlocks a ship shield." },
        weapon: { value: 3, description: "The application unlocks a ship weapon." },
        fuel: { value: 4, description: "The application improves ship fuel range." },
        drive: { value: 5, description: "The application unlocks a ship drive." },
        reserved_6: { value: 6, description: "Reserved native category retained for compatibility; do not assign it to new applications." },
        armor: { value: 7, description: "The application unlocks ship armor." },
        computer: { value: 8, description: "The application unlocks a targeting computer." },
        special: { value: 9, description: "The application unlocks a ship special system." },
      },
    },
    technology_application: {
      title: "Technology application",
      description: "Identifies one entry in the native technology application table.",
      remarks: "Complete 212-entry MOO2 1.50 domain. Names preserve the public 1.50 tech_mini vocabulary even where restored C++ constants use a different spelling.",
      kind: "enum",
      base_type: "uint16",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        no_tech: 0, achilles_targeting_unit: 1, adamantium_armor: 2, advanced_city_planning: 3,
        advanced_damage_control: 4, alien_management_center: 5, android_farmers: 6, android_scientists: 7,
        android_workers: 8, anti_grav_harness: 9, anti_matter_bomb: 10, anti_matter_drive: 11,
        anti_matter_torpedo: 12, anti_missile_rocket: 13, armor_barracks: 14, artemis_system_net: 15,
        planet_construction: 16, assault_shuttles: 17, astro_university: 18, atmospheric_renewer: 19,
        augmented_engines: 20, autolab: 21, automated_factories: 22, automated_repair_unit: 23,
        battleoids: 24, battle_pods: 25, battle_scanner: 26, battlestation: 27,
        bio_terminator: 28, biomorphic_fungi: 29, black_hole_generator: 30, bomber_bays: 31,
        capitol: 32, class_i_shield: 33, class_iii_shield: 34, class_v_shield: 35,
        class_vii_shield: 36, class_x_shield: 37, cloaking_device: 38, cloning_center: 39,
        colony_base: 40, colony_ship: 41, confederation: 42, cyber_security_link: 43,
        cybertronic_computer: 44, damper_field: 45, dauntless_guidance_system: 46, death_ray: 47,
        death_spores: 48, deep_core_mining: 49, core_waste_dumps: 50, deuterium_fuel_cells: 51,
        dimensional_portal: 52, displacement_device: 53, disrupter_cannon: 54, doom_star_construction: 55,
        reinforced_hull: 56, ecm_jammer: 57, electronic_computer: 58, emissions_guidance_system: 59,
        energy_absorber: 60, biospheres: 61, evolutionary_mutation: 62, extended_fuel_tanks: 63,
        fast_missile_racks: 64, federation: 65, fighter_bays: 66, fighter_garrison: 67,
        food_replicators: 68, freighters: 69, fusion_beam: 70, fusion_bomb: 71,
        fusion_drive: 72, fusion_rifle: 73, gaia_transformation: 74, galactic_currency_exchange: 75,
        galactic_cybernet: 76, galactic_unification: 77, gauss_cannon: 78, graviton_beam: 79,
        gyro_destabilizer: 80, hard_shields: 81, heavy_armor: 82, heavy_fighter_bays: 83,
        heightened_intelligence: 84, high_energy_focus: 85, holo_simulator: 86, hydroponic_farm: 87,
        hyper_drive: 88, megafluxers: 89, hyper_x_capacitors: 90, hyperspace_communications: 91,
        imperium: 92, inertial_nullifier: 93, inertial_stabilizer: 94, interphased_drive: 95,
        ion_drive: 96, ion_pulse_cannon: 97, iridium_fuel_cells: 98, jump_gate: 99,
        laser_cannon: 100, laser_rifle: 101, lightning_field: 102, marine_barracks: 103,
        mass_driver: 104, mauler_device: 105, merculite_missile: 106, microbiotics: 107,
        microlite_construction: 108, outpost_ship: 109, moleculartronic_computer: 110, multi_wave_ecm_jammer: 111,
        multi_phased_shields: 112, nano_disassemblers: 113, neural_scanner: 114, neutron_blaster: 115,
        neutron_scanner: 116, neutronium_armor: 117, neutronium_bomb: 118, nuclear_bomb: 119,
        nuclear_drive: 120, nuclear_missile: 121, optronic_computer: 122, particle_beam: 123,
        personal_shield: 124, phase_shifter: 125, phasing_cloak: 126, phasor: 127,
        phasor_rifle: 128, planetary_barrier_shield: 129, planetary_flux_shield: 130, planetary_gravity_generator: 131,
        planetary_missile_base: 132, ground_batteries: 133, planetary_radiation_shield: 134, planetary_stock_exchange: 135,
        planetary_supercomputer: 136, plasma_cannon: 137, plasma_rifle: 138, plasma_torpedo: 139,
        plasma_web: 140, pleasure_dome: 141, pollution_processor: 142, positronic_computer: 143,
        powered_armor: 144, pulse_rifle: 145, proton_torpedo: 146, psionics: 147,
        pulsar: 148, pulson_missile: 149, quantum_detonator: 150, rangemaster_unit: 151,
        recyclotron: 152, reflection_field: 153, robotic_factory: 154, research_laboratory: 155,
        robo_miners: 156, space_scanner: 157, scout_lab: 158, security_stations: 159,
        sensors: 160, shield_capacitors: 161, soil_enrichment: 162, space_academy: 163,
        spaceport: 164, spatial_compressor: 165, spy_network: 166, standard_fuel_cells: 167,
