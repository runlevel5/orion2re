        tachyon_communications: 180, tachyon_scanner: 181, telepathic_training: 182, terraforming: 183,
        thorium_fuel_cells: 184, time_warp_facilitator: 185, titan_construction: 186, titanium_armor: 187,
        tractor_beam: 188, transport: 189, transporters: 190, tritanium_armor: 191,
