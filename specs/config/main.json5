  },
  records: {
    miniaturization_settings: {
      title: "Miniaturization curves",
      description: "Cost percentages and category-specific space multipliers for miniaturization levels 0 through 5.",
      fields: [
        {
          id: "cost", title: "Cost curve", description: "Component cost percentage at each miniaturization level.", bind: ["cost"],
          type: { kind: "array", count: 6, index_base: 0, element: { type: "uint16" } },
        },
        {
          id: "space", title: "Space curves", description: "Per-thousand component space multiplier for each category and miniaturization level.", bind: ["space"],
          type: {
            kind: "array", count: 3, index_base: 0, index_type: "miniaturization_category",
            element: { type: { kind: "array", count: 6, index_base: 0, element: { type: "uint16" } } },
          },
        },
      ],
    },
    missile_defense: {
      title: "Tactical missile defense",
      description: "Controls Cloaking Device and Displacement Device protection against tactical missiles.",
      fields: [
        {
          id: "cloaking_device_missile_defense",
          title: "Cloaking Device missile evasion",
          description: "Missile Evasion added while actively cloaked. Zero retains the classic independent cloak miss chance.",
          type: "uint8",
          bind: ["cloaking_device_missile_defense"],
        },
        {
          id: "cloaking_device_missile_miss_percent",
          title: "Cloaking Device missile miss chance",
          description: "Independent missile miss chance while actively cloaked when cloak missile evasion is zero.",
          type: "uint8",
          bind: ["cloaking_device_missile_miss_percent"],
        },
        {
          id: "displacement_device_missiles_miss_percent",
          title: "Displacement Device missile miss chance",
          description: "Chance for a missile or an Energy Absorber attack to miss a ship with a working Displacement Device.",
          type: "uint8",
          bind: ["displacement_device_missiles_miss_percent"],
        },
      ],
    },
    autobuild_settings: {
      title: "Experimental autobuild settings",
      description: "Controls queue-driven colony autobuild behavior.",
      fields: [
        { id: "enabled", title: "Enabled", description: "Enables queue-driven colony autobuild.", type: "bool", bind: ["enabled"] },
        { id: "default", title: "Default queue", description: "Queue number prefilled when assigning autobuild to a colony.", type: "uint8", constraints: { min: 0, max: 10 }, bind: ["default_preset"] },
      ],
    },
    scan_bonus: {
      title: "Strategic scan bonuses",
      description: "Controls scanner, ship-system, orbital-base, and same-location strategic detection values.",
      fields: [
        { id: "battle_scanner", title: "Battle Scanner", description: "Detection added by a working Battle Scanner.", type: "uint16", constraints: { max: 32767 }, bind: ["battle_scanner"] },
        { id: "scout_lab", title: "Scout Lab", description: "Detection added by a working Scout Lab.", type: "uint16", constraints: { max: 32767 }, bind: ["scout_lab"] },
        { id: "star_base", title: "Star Base", description: "Detection added by a colony Star Base.", type: "uint16", constraints: { max: 32767 }, bind: ["star_base"] },
        { id: "battlestation", title: "Battlestation", description: "Detection added by a colony Battlestation.", type: "uint8", constraints: { max: 127 }, bind: ["battlestation"] },
        { id: "star_fortress", title: "Star Fortress", description: "Detection added by a colony Star Fortress.", type: "uint8", constraints: { max: 127 }, bind: ["star_fortress"] },
        { id: "no_scanner", title: "No scanner", description: "Base detection range without advanced scanner technology.", type: "uint8", constraints: { max: 127 }, bind: ["no_scanner"] },
        { id: "tachyon_scanner", title: "Tachyon Scanner", description: "Detection range with Tachyon Scanner technology.", type: "uint8", constraints: { max: 127 }, bind: ["tachyon_scanner"] },
        { id: "neutron_scanner", title: "Neutron Scanner", description: "Detection range with Neutron Scanner technology.", type: "uint8", constraints: { max: 127 }, bind: ["neutron_scanner"] },
        { id: "sensors", title: "Sensors", description: "Detection range with Sensors technology.", type: "uint8", constraints: { max: 127 }, bind: ["sensors"] },
        { id: "planet", title: "Planet proximity", description: "Detection applied when the target shares a colony's location.", type: "uint16", bind: ["planet"] },
        { id: "fleet", title: "Fleet proximity", description: "Detection applied when the target shares a friendly fleet's location.", type: "uint16", bind: ["fleet"] },
      ],
    },
    stealth_bonus: {
      title: "Strategic stealth bonuses",
      description: "Controls strategic concealment from racial and ship-system stealth sources.",
      fields: [
        { id: "stealthy_ships", title: "Stealthy Ships", description: "Concealment added by the Stealthy Ships racial trait.", type: "int16", bind: ["stealthy_ships"] },
        { id: "stealth_field", title: "Stealth Field", description: "Concealment added by a working Stealth Field.", type: "int16", bind: ["stealth_field"] },
        { id: "cloaking_device", title: "Cloaking Device", description: "Concealment added by a working Cloaking Device.", type: "int16", bind: ["cloaking_device"] },
        { id: "phasing_cloak", title: "Phasing Cloak", description: "Concealment added by a working Phasing Cloak.", type: "int16", bind: ["phasing_cloak"] },
      ],
    },
    predefined_ship_weapon: {
      title: "Predefined ship weapon slot",
      description: "One of the eight weapon slots in a predefined ship design.",
      remarks: "Amount initializes both the installed and current weapon counts.",
      fields: [
        { id: "type", title: "Weapon", description: "Weapon installed in this slot.", type: "ship_weapon", bind: ["type"] },
        { id: "arc", title: "Firing arc", description: "Directions in which the weapon may fire.", type: "weapon_firing_arc", bind: ["firing_arc"] },
        { id: "mods", title: "Weapon modifications", description: "Modifications installed on this weapon.", type: "available_weapon_modification_mask", bind: ["specials"] },
        { id: "ammo", title: "Ammunition", description: "Ammunition or shot count associated with the weapon.", type: "int8", bind: ["ammo"] },
        { id: "amount", title: "Amount", description: "Number of weapons installed in this slot.", type: "int8", constraints: { min: 0 }, bind: ["count", "current_count"] },
      ],
    },
    predefined_ship_design: {
      title: "Predefined ship design",
      description: "Publicly configurable fields copied into a predefined strategic ship.",
      remarks: "Runtime-only identity, ownership, cost, and derived speed fields are completed by the loader.",
      fields: [
        { id: "appearance", title: "Appearance", description: "Ship picture index.", type: "int8", bind: ["picture_num"] },
        { id: "hull_size", title: "Hull size", description: "Hull size used by the ship.", type: "ship_hull_size", bind: ["size"] },
        { id: "drive", title: "Drive", description: "FTL drive stored in the design.", type: "ship_drive", bind: ["ftl_type"] },
        { id: "armor", title: "Armor", description: "Armor material stored in the design.", type: "ship_armor", bind: ["armor_type"] },
        { id: "shield", title: "Shield", description: "Shield stored in the design.", type: "ship_shield", bind: ["shield_type"] },
        { id: "computer", title: "Computer", description: "Targeting computer stored in the design.", type: "ship_computer", bind: ["computer_type"] },
        {
          id: "weapons", title: "Weapons", description: "Eight native weapon slots.", bind: ["ship_weapon"],
          type: { kind: "array", count: 8, index_base: 1, element: { type: "predefined_ship_weapon" } },
        },
        { id: "specials", title: "Special systems", description: "Special systems installed in the design.", type: "ship_specials", bind: ["special_device_flags"] },
      ],
    },
    repair_rate: {
      title: "Tactical repair rates",
      description: "Controls end-of-round armor, structure, and internal-system repair percentages.",
      fields: [
        { id: "cyber", title: "Cybernetic", description: "Repair percentage supplied by the Cybernetic racial trait.", type: "uint8", bind: ["cyber"] },
        { id: "aru", title: "Automated Repair Unit", description: "Repair percentage supplied by a working Automated Repair Unit.", type: "uint8", bind: ["aru"] },
        { id: "regen", title: "Regeneration", description: "Repair percentage supplied by a working Regeneration special when Amoeba regeneration is enabled.", type: "uint8", bind: ["regen"] },
      ],
    },
  },

  parameters: {
    build_queue: {
      title: "Automatic build queues",
      description: "Defines the eleven build lists applied by Q and the digit hotkeys.",
      remarks: "Q selects list 0; keys 1 through 9 select matching list numbers; key 0 selects list 10. Shift plus a digit applies that list to every owned colony from the colony summary. clear_continuous removes Housing and Trade Goods from the editable queue while preserving a purchased front item.",
      examples: [
        "colony build_queue 1 = prepend design1 end;",
        "colony build_queue 9 = housing end;",
      ],
      group: "gameplay",
      namespace: "colony",
      bind_root: { header: "game/build_queue.h", symbol: "BUILD_QUEUE::presets" },
      type: {
        kind: "array", count: 11, index_base: 0,
        element: { type: {
          kind: "array", count: 200, index_base: 0,
          fill: "end", terminator: "end",
          element: { type: "build_queue_instruction" },
        } },
