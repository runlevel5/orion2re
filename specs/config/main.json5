{
  // Declaration order is public traversal order. This bootstrap contains only
  // primitive scalar settings already present in the restored game.
  groups: {
    interface: {
      title: "Interface",
      description: "Local presentation, audio, and control settings.",
      save: false,
      synchronize: false,
    },
    gameplay: {
      title: "Gameplay",
      description: "Deterministic gameplay definitions shared by all players.",
      save: true,
      synchronize: true,
    },
  },

  types: {
    // New-game setup domains. These are complete closed sets stored as bytes.
    game_difficulty: {
      title: "Game difficulty",
      description: "Difficulty selected when a new game is created.",
      remarks: "Complete uint8 domain. Numeric configuration preserves the native values 0 through 4.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { tutor: 0, easy: 1, average: 2, hard: 3, impossible: 4 },
    },
    galaxy_age: {
      title: "Galaxy age",
      description: "Stellar age distribution selected for map generation.",
      remarks: "Complete uint8 domain. Numeric configuration preserves the native values 0 through 2.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { young: 0, average: 1, old: 2 },
    },
    galaxy_size: {
      title: "Galaxy size",
      description: "Map-size selection used by new-game setup.",
      remarks: "Complete uint8 domain. Maximum is the extended fifth size and retains native value 4.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { small: 0, medium: 1, large: 2, huge: 3, maximum: 4 },
    },

    // Race and leadership domains. Stock race is a table index, not ownership.
    government: {
      title: "Government",
      description: "A race's base or advanced form of government.",
      remarks: "Complete uint8 semantic-ID domain. The advanced form of each base government has its own native value.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        feudal: 0,
        confederation: 1,
        dictatorship: 2,
        imperium: 3,
        democracy: 4,
        federation: 5,
        unification: 6,
        galactic_unification: 7,
      },
    },
    stock_race_index: {
      title: "Stock race table index",
      description: "Index into the thirteen-entry table of predefined races.",
      remarks: "Complete uint8 index domain. Do not use for player ownership, packed population race data, Androids, natives, or custom-race selections.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        alkari: 0,
        bulrathi: 1,
        darlok: 2,
        elerian: 3,
        gnolam: 4,
        human: 5,
        klackon: 6,
        meklar: 7,
        mrrshan: 8,
        psilon: 9,
        sakkra: 10,
        silicoid: 11,
        trilarian: 12,
      },
    },
    crew_quality: {
      title: "Crew quality",
      description: "Experience rank assigned to a ship's crew.",
      remarks: "Complete uint8 ordered domain from green through ultra elite.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { green: 0, regular: 1, veteran: 2, elite: 3, ultra_elite: 4 },
    },
    leader_type: {
      title: "Leader type",
      description: "Determines whether a leader commands ships or administers colonies.",
      remarks: "Complete uint8 semantic-ID domain. This does not describe leader employment status.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { ship: 0, colony: 1 },
    },

    // Strategic data-table classifications.
    strategic_special_category: {
      title: "Strategic special category",
      description: "AI-oriented category describing the strategic effect of a ship special.",
      remarks: "Complete uint8 semantic-ID domain. Values are categories, not SPECIAL IDs or a bit mask.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        none: 0,
        beam_accuracy: 1,
        beam_damage: 2,
        beam_defense: 3,
        missile_defense: 4,
        missile_damage: 5,
        beam_missile_defense: 6,
        beam_missile_damage: 7,
      },
    },
    technology_application_type: {
      title: "Technology application type",
      description: "Classifies the native object produced by a technology application.",
      remarks: "Complete uint8 semantic-ID domain. Value 6 is reserved and remains valid for native compatibility; this is not the application ai_group field.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        unclassified: 0,
        building: 1,
        shield: 2,
        weapon: 3,
        fuel: 4,
        drive: 5,
        reserved_6: 6,
        armor: 7,
        computer: 8,
        special: 9,
      },
    },
    planet_environment_group: {
      title: "Planet environmental group",
      description: "Groups planet climates for map-generation environment tables.",
      remarks: "Complete uint8 table-index domain. It is separate from individual planet climate IDs.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { bombarded: 0, hostile: 1, life_supporting: 2, lifeless: 3 },
    },
    map_generation_satellite: {
      title: "Map-generation satellite choice",
      description: "Selects the kind of object generated in a system orbit.",
      remarks: "Complete uint8 choice domain. Companion star is value 4; later spectral encodings and generic orbit indexes are not members.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        invalid: 0,
        asteroid: 1,
        gas_giant: 2,
        planet: 3,
        companion_star: 4,
      },
    },

    // AI design table discriminators and themes.
    ai_special_choice_item_kind: {
      title: "AI special-choice item kind",
      description: "Discriminates a SPECIAL ID from a WEAPON ID in an AI special-choice entry.",
      remarks: "Complete uint8 discriminator domain. The referenced item ID retains its own independent domain.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { special: 0, weapon: 1 },
    },
    ai_ship_design_theme: {
      title: "AI ship design theme",
      description: "Chooses the primary AI strategy used to equip a ship design.",
      remarks: "Complete uint8 semantic-ID domain. Human value 100 is the native non-AI sentinel, not a table index.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { balanced: 0, carrier: 1, missile: 2, special: 3, human: 100 },
    },
    ai_ship_special_theme: {
      title: "AI ship special theme",
      description: "Chooses the strategic category favored when the AI installs ship specials.",
      remarks: "Complete uint8 semantic-ID domain. Human value 100 is the native non-AI sentinel, not an eighth AI table class.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        beam_defense: 0,
        capture: 1,
        bio_weapon: 2,
        missile_defense: 3,
        cloaking: 4,
        armor: 5,
        shield: 6,
        human: 100,
      },
    },

    // Weapon modification IDs, available flags, natural properties, and arcs
    // have overlapping numbers but intentionally remain separate types.
    weapon_modification_id: {
      title: "Weapon modification ID",
      description: "Identifies one weapon modification by its native ordinal.",
      remarks: "Complete uint8 semantic-ID domain using the MOO2 1.50 value names. ID zero means no modification; IDs are not available-modification flag bits.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        no_mods: 0,
        heavy_mount: 1,
        point_defense: 2,
        armor_piercing: 3,
        continuous: 4,
        no_range_dissipation: 5,
        shield_piercing: 6,
        auto_fire: 7,
        enveloping: 8,
        mirv: 9,
        eccm: 10,
        heavily_armored: 11,
        fast: 12,
        emissions_guidance: 13,
        overloaded: 14,
      },
    },
    available_weapon_modification_mask: {
      title: "Available weapon modification mask",
      description: "Bit set describing which modifications may be installed on a weapon.",
      remarks: "Complete uint16 mask using the compact MOO2 1.50 flag names. Bit zero is reserved; modification ID N maps to bit N and therefore remains distinct from the ID domain.",
      kind: "mask",
      base_type: "int16",
      allow_numeric: true,
      reject_unknown_bits: true,
      values: { none: 0x0000 },
      flags: {
        reserved_0: {
          value: 0x0001,
          description: "Reserved compatibility bit. Do not use it in new configurations.",
        },
        hv: {
          value: 0x0002,
          description: "Heavy Mount increases a beam weapon's damage, cost, and space use.",
        },
        pd: {
          value: 0x0004,
          description: "Point Defense adapts a beam weapon for accurate short-range defensive fire.",
        },
        ap: {
          value: 0x0008,
          description: "Armor Piercing helps the weapon penetrate armor.",
        },
        co: {
          value: 0x0010,
          description: "Continuous makes a beam easier to keep on target.",
        },
        nr: {
          value: 0x0020,
          description: "No Range Dissipation prevents the weapon from losing damage over distance.",
        },
        sp: {
          value: 0x0040,
          description: "Shield Piercing allows the weapon to bypass shields.",
        },
        af: {
          value: 0x0080,
          description: "Auto Fire fires multiple shots in one attack.",
        },
        env: {
          value: 0x0100,
          description: "Enveloping attacks the target from every side.",
        },
        mv: {
          value: 0x0200,
          description: "MIRV splits one missile into multiple warheads near its target.",
        },
        eccm: {
          value: 0x0400,
          description: "ECCM helps missiles resist enemy electronic countermeasures.",
        },
        arm: {
          value: 0x0800,
          description: "Heavily Armored makes missiles harder to destroy before impact.",
        },
        fst: {
          value: 0x1000,
          description: "Fast increases missile speed.",
        },
        emg: {
          value: 0x2000,
          description: "Emission Guidance lets a missile continue tracking certain cloaked targets.",
        },
        ovr: {
          value: 0x4000,
          description: "Overloaded increases torpedo damage at additional cost and space use.",
        },
      },
    },
    natural_weapon_property_mask: {
      title: "Natural weapon property mask",
      description: "Intrinsic combat and AI metadata bits attached to a weapon definition.",
      remarks: "Complete uint16 mask using the compact MOO2 1.50 flag names. These properties are independent from installed or available weapon modification flags even where bit positions overlap.",
      kind: "mask",
      base_type: "uint16",
      allow_numeric: true,
      reject_unknown_bits: true,
      values: { none: 0x0000 },
      flags: {
        sh: {
          value: 0x0001,
          description: "The weapon is especially effective against shields.",
        },
        dr: {
          value: 0x0002,
          description: "The weapon loses effectiveness over distance twice as quickly as normal.",
        },
        nr: {
          value: 0x0004,
          description: "The weapon does not lose damage over distance.",
        },
        ion: {
          value: 0x0008,
          description: "The weapon bypasses armor and structure to damage internal systems.",
        },
        mar: {
          value: 0x0010,
          description: "The weapon can kill marines aboard the target ship.",
        },
        esd: {
          value: 0x0020,
          description: "The weapon inflicts additional structural damage.",
        },
        co: {
          value: 0x0040,
          description: "The weapon's continuous beam is easier to keep on target.",
        },
        bio: {
          value: 0x0080,
          description: "The weapon uses a biological payload against a colony's population.",
        },
        sp: {
          value: 0x0100,
          description: "The weapon ignores shields.",
        },
        env: {
          value: 0x0200,
          description: "The weapon strikes the target from every side.",
        },
        hit: {
          value: 0x0400,
          description: "The weapon always hits its selected target.",
        },
        ai1: {
          value: 0x0800,
          description: "Internal AI marker used for plasma torpedoes. Most configurations should leave it unchanged.",
        },
        ai2: {
          value: 0x1000,
          description: "Internal AI marker used for spatial compressors. Most configurations should leave it unchanged.",
        },
      },
    },
    weapon_firing_arc: {
      title: "Weapon firing arc",
      description: "Native firing-sector encoding used by tactical and design data.",
      remarks: "Complete uint8 encoding domain. Tactical all_sectors is 15, while the design-screen design_360 choice is the distinct value 16; they must never be interchanged.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        none: 0x00,
        forward: 0x01,
        forward_extended: 0x02,
        back_extended: 0x04,
        rear: 0x08,
        all_sectors: 0x0F,
        design_360: 0x10,
      },
    },
    ship_hull_size: {
      title: "Ship hull size",
      description: "Hull size stored in a predefined ship design.",
      remarks: "Complete combat-ship hull domain used by predefined designs.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { frigate: 0, destroyer: 1, cruiser: 2, battleship: 3, titan: 4 },
    },
    ship_drive: {
      title: "Ship drive",
      description: "FTL drive installed in a predefined ship design.",
      remarks: "Complete native drive domain.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { none: 0, nuclear: 1, fusion: 2, ion: 3, anti_matter: 4, hyper: 5, interphased: 6 },
    },
    ship_armor: {
      title: "Ship armor",
      description: "Armor material installed in a predefined ship design.",
      remarks: "Complete native armor domain.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { none: 0, titanium: 1, tritanium: 2, zortrium: 3, neutronium: 4, adamantium: 5, xentronium: 6 },
    },
    ship_shield: {
      title: "Ship shield",
      description: "Shield installed in a predefined ship design.",
      remarks: "Complete native ship-shield domain.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { none: 0, class_i: 1, class_iii: 2, class_v: 3, class_vii: 4, class_x: 5 },
    },
    ship_computer: {
      title: "Ship computer",
      description: "Targeting computer installed in a predefined ship design.",
      remarks: "Complete native ship-computer domain.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { none: 0, electronic: 1, optronic: 2, positronic: 3, cybertronic: 4, moleculartronic: 5 },
    },
    ship_weapon: {
      title: "Ship weapon",
      description: "Weapon installed in a predefined ship design slot.",
      remarks: "Complete native weapon domain, including monster weapons.",
      kind: "enum",
      base_type: "uint16",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        none: 0, mass_driver: 1, gauss_cannon: 2, laser_cannon: 3,
        particle_beam: 4, fusion_beam: 5, ion_pulse_cannon: 6,
        graviton_beam: 7, neutron_blaster: 8, phasor: 9, disrupter: 10,
        death_ray: 11, plasma_cannon: 12, spatial_compressor: 13,
        nuclear_missile: 14, merculite_missile: 15, pulson_missile: 16,
        zeon_missile: 17, anti_matter_torpedo: 18, proton_torpedo: 19,
        plasma_torpedo: 20, nuclear_bomb: 21, fusion_bomb: 22,
        anti_matter_bomb: 23, neutronium_bomb: 24, death_spore: 25,
        bio_terminator: 26, mauler_device: 27, assault_shuttle: 28,
        heavy_fighter: 29, bomber: 30, interceptor: 31, stasis_field: 32,
        anti_missile_rocket: 33, gyro_destabilizer: 34, plasma_web: 35,
        pulsar: 36, black_hole_generator: 37, stellar_converter: 38,
        tractor_beam: 39, dragon_breath: 40, phasor_eye: 41,
        crystal_ray: 42, plasma_breath: 43, plasma_flux: 44,
        caustic_slime: 45,
      },
    },
    ship_specials: {
      title: "Ship special systems",
      description: "Special systems installed in a predefined ship design.",
      remarks: "The native representation is a five-byte bitmap. Bit indexes match the SPECIAL domain.",
      kind: "bitmap",
      bit_count: 40,
      values: { none: [] },
      flags: {
        achilles_targeting_unit: 1, augmented_engines: 2, automated_repair_unit: 3,
        battle_pods: 4, battle_scanner: 5, cloaking_device: 6, damper_field: 7,
        displacement_device: 8, ecm_jammer: 9, energy_absorber: 10,
        extended_fuel_tanks: 11, fast_missile_racks: 12, hard_shields: 13,
        heavy_armor: 14, high_energy_focus: 15, hyper_x_capacitors: 16,
        inertial_nullifier: 17, inertial_stabilizer: 18, lightning_field: 19,
        multi_phased_shields: 20, multi_wave_ecm_jammer: 21, phase_shifter: 22,
        phasing_cloak: 23, quantum_detonator: 24, rangemaster_unit: 25,
        reflection_field: 26, reinforced_hull: 27, scout_lab: 28,
        security_stations: 29, shield_capacitor: 30, stealth_field: 31,
        structural_analyzer: 32, sub_space_teleporter: 33,
        time_warp_facilitator: 34, transporters: 35, troop_pods: 36,
        warp_dissipator: 37, wide_area_jammer: 38, regeneration: 39,
      },
    },
    monster_design_variant: {
      title: "Monster design variant",
      description: "Selects the stationary system guardian or mobile event monster design.",
      remarks: "The native loader boolean uses zero for system and one for event.",
      kind: "enum",
      base_type: "uint8",
      values: { system: 0, event: 1 },
    },
  },
  records: {
    predefined_ship_weapon: {
      title: "Predefined ship weapon slot",
      description: "One of the eight weapon slots in a predefined ship design.",
      remarks: "Amount initializes both the installed and current weapon counts.",
      fields: [
        { id: "type", title: "Weapon", description: "Weapon installed in this slot.", type: "ship_weapon", bind: ["type"] },
        { id: "arc", title: "Firing arc", description: "Directions in which the weapon may fire.", type: "weapon_firing_arc", bind: ["firing_arc"] },
        { id: "mods", title: "Weapon modifications", description: "Modifications installed on this weapon.", type: "available_weapon_modification_mask", bind: ["specials"] },
        { id: "ammo", title: "Ammunition", description: "Ammunition or shot count associated with the weapon.", type: "int8", bind: ["ammo"] },
        { id: "amount", title: "Amount", description: "Number of weapons installed in this slot.", type: "int8", constraints: { min: 0 }, bind: ["count", "current_count"] },
      ],
    },
    predefined_ship_design: {
      title: "Predefined ship design",
      description: "Publicly configurable fields copied into a predefined strategic ship.",
      remarks: "Runtime-only identity, ownership, cost, and derived speed fields are completed by the loader.",
      fields: [
        { id: "appearance", title: "Appearance", description: "Ship picture index.", type: "int8", bind: ["picture_num"] },
        { id: "hull_size", title: "Hull size", description: "Hull size used by the ship.", type: "ship_hull_size", bind: ["size"] },
        { id: "drive", title: "Drive", description: "FTL drive stored in the design.", type: "ship_drive", bind: ["ftl_type"] },
        { id: "armor", title: "Armor", description: "Armor material stored in the design.", type: "ship_armor", bind: ["armor_type"] },
        { id: "shield", title: "Shield", description: "Shield stored in the design.", type: "ship_shield", bind: ["shield_type"] },
        { id: "computer", title: "Computer", description: "Targeting computer stored in the design.", type: "ship_computer", bind: ["computer_type"] },
        {
          id: "weapons", title: "Weapons", description: "Eight native weapon slots.", bind: ["ship_weapon"],
          type: { kind: "array", count: 8, index_base: 1, element: { type: "predefined_ship_weapon" } },
        },
        { id: "specials", title: "Special systems", description: "Special systems installed in the design.", type: "ship_specials", bind: ["special_device_flags"] },
      ],
    },
  },

  parameters: {
    guardian: {
      title: "Guardian design",
      description: "Configures Orion's Guardian ship.",
      examples: ["ships guardian weapons 1 = death_ray all_sectors hv 0 2;"],
      group: "gameplay",
      namespace: "ships",
      type: "predefined_ship_design",
      bind_root: { header: "game/ship_config.h", symbol: "SHIP_CONFIG::guardian_template" },
      default: { appearance: 7, hull_size: 4, drive: 0, armor: 6, shield: 3, computer: 5, weapons: [
        { type: 11, arc: 15, mods: 2, ammo: 0, amount: 2 }, { type: 4, arc: 15, mods: 4, ammo: 0, amount: 10 },
        { type: 20, arc: 15, mods: 17664, ammo: 0, amount: 1 }, { type: 20, arc: 15, mods: 17664, ammo: 0, amount: 1 },
        { type: 13, arc: 15, mods: 0, ammo: 0, amount: 2 }, { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 },
        { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 }, { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 },
      ], specials: "achilles_targeting_unit,automated_repair_unit,battle_scanner,hard_shields,inertial_stabilizer,lightning_field,multi_wave_ecm_jammer,rangemaster_unit" },
    },
    avenger: {
      title: "Avenger design",
      description: "Configures the Loknar or Avenger ship.",
      group: "gameplay",
      namespace: "ships",
      type: "predefined_ship_design",
      bind_root: { header: "game/ship_config.h", symbol: "SHIP_CONFIG::avenger_template" },
      default: { appearance: 44, hull_size: 3, drive: 6, armor: 6, shield: 0, computer: 5, weapons: [
        { type: 4, arc: 1, mods: 2, ammo: 0, amount: 4 }, { type: 11, arc: 1, mods: 2, ammo: 0, amount: 2 },
        { type: 4, arc: 1, mods: 0, ammo: 0, amount: 10 }, { type: 13, arc: 15, mods: 0, ammo: 0, amount: 2 },
        { type: 4, arc: 1, mods: 4, ammo: 0, amount: 10 }, { type: 24, arc: 1, mods: 0, ammo: 10, amount: 15 },
        { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 }, { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 },
      ], specials: "damper_field,quantum_detonator,sub_space_teleporter" },
    },
    amoeba: {
      title: "Amoeba designs", description: "Configures system and event Amoeba ships.", group: "gameplay",
      namespace: "ships",
      bind_root: { header: "game/ship_config.h", symbol: "SHIP_CONFIG::amoeba_templates" },
      type: { kind: "array", count: 2, index_base: 0, index_type: "monster_design_variant", element: { type: "predefined_ship_design" } },
      default: [
        { appearance: 20, hull_size: 2, drive: 0, armor: 0, shield: 0, computer: 2, weapons: [
          { type: 45, arc: 15, mods: 0, ammo: 0, amount: 1 }, { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 }, { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 }, { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 },
          { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 }, { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 }, { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 }, { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 },
        ], specials: "regeneration" },
        { appearance: 8, hull_size: 3, drive: 2, armor: 0, shield: 0, computer: 2, weapons: [
          { type: 45, arc: 15, mods: 0, ammo: 0, amount: 2 }, { type: 23, arc: 15, mods: 0, ammo: 10, amount: 5 }, { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 }, { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 },
          { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 }, { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 }, { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 }, { type: 0, arc: 0, mods: 0, ammo: 0, amount: 0 },
        ], specials: "regeneration" },
      ],
    },
    crystal: {
      title: "Crystal designs", description: "Configures system and event Crystal ships.", group: "gameplay",
