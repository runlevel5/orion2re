        structural_analyzer: 32, sub_space_teleporter: 33,
        time_warp_facilitator: 34, transporters: 35, troop_pods: 36,
        warp_dissipator: 37, wide_area_jammer: 38, regeneration: 39,
      },
    },
    building: {
      title: "Colony building",
      description: "Identifies one entry in the native colony building table.",
      remarks: "Complete uint8 BUILDING domain. None is also the terminator for building lists.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        none: 0, alien_control_center: 1, armor_barracks: 2,
        artemis_system_net: 3, astro_university: 4, atmosphere_renewer: 5,
        autolab: 6, automated_factory: 7, battlestation: 8, capitol: 9,
        cloning_center: 10, colony_base: 11, deep_core_mine: 12,
        core_waste_dump: 13, dimensional_portal: 14, biospheres: 15,
        food_replicators: 16, gaia_transformation: 17, currency_exchange: 18,
        galactic_cybernet: 19, holo_simulator: 20, hydroponic_farm: 21,
        marine_barracks: 22, barrier_shield: 23, flux_shield: 24,
        gravity_generator: 25, missile_base: 26, ground_batteries: 27,
        radiation_shield: 28, stock_exchange: 29, supercomputer: 30,
        pleasure_dome: 31, pollution_processor: 32, recyclotron: 33,
        robotic_factory: 34, research_lab: 35, robo_miner_plant: 36,
        soil_enrichment: 37, space_academy: 38, spaceport: 39,
        star_base: 40, star_fortress: 41, stellar_converter: 42,
        subterranean_farms: 43, terraforming: 44, warp_interdictor: 45,
        weather_controller: 46, fighter_garrison: 47, artificial_planet: 48,
      },
    },
    monster_design_variant: {
      title: "Monster design variant",
      description: "Selects the stationary system guardian or mobile event monster design.",
      remarks: "The native loader boolean uses zero for system and one for event.",
      kind: "enum",
      base_type: "uint8",
      values: { system: 0, event: 1 },
    },
    stealth_size_penalty: {
      title: "Stealth size-penalty policy",
      description: "Selects which strategic concealment sources suppress the traveling-ship hull-size penalty.",
      remarks: "The race_tech default matches MOO2 1.40 and MOO2 1.50 behavior.",
      kind: "enum",
      base_type: "uint8",
      values: { none: 0, race: 1, race_tech: 2 },
    },
    lightning_field_mode: {
      title: "Lightning Field distribution",
      description: "Selects how Lightning Field destruction rolls are distributed across an incoming stack.",
      remarks: "Classic preserves the original shrinking-loop distribution. Uniform tests every incoming weapon independently.",
      kind: "enum",
      base_type: "uint8",
      values: { classic: 0, uniform: 1 },
    },
    random_event: {
      title: "Random event",
      description: "Identifies one event selected by the strategic random-event generator.",
      remarks: "Complete native random-event domain. Compatibility note: this schema uses the canonical game-facing name mineral_depletion for event 11; MOO2 1.50 CFG files used overworking and must rename that selector when converted.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        derelict: 0,
        climatic_change: 1,
        comet: 2,
        computer_virus: 3,
        diplomatic_blunder: 4,
        diplomatic_marriage: 5,
        donation: 6,
        earthquake: 7,
        freak_accident: 8,
        hyperspace_flux: 9,
        industrial_accident: 10,
        mineral_depletion: 11,
        mineral_deposit: 12,
        mutiny: 13,
        pirate_activity: 14,
        pirate_raid: 15,
        plague: 16,
        population_boom: 17,
        serendipity: 18,
        space_amoeba: 19,
        space_crystal: 20,
        space_dragon: 21,
        space_eel: 22,
        space_hydra: 23,
        supernova: 24,
        time_space_anomaly: 25,
        warp_beast: 26,
        warp_funnel: 27,
        unstable_wormhole: 28,
      },
    },
    build_queue_instruction: {
      title: "Build queue instruction",
      description: "A mode, command, product, design, or building in an automatic build list.",
      remarks: "Lists must end with end. At most 199 executable instructions fit before that marker.",
      kind: "enum",
      base_type: "uint8",
      values: {
        end: 0, append: 1, prepend: 2, merge: 3,
