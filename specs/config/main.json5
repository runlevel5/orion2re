  parameters: {
    build_queue: {
      title: "Automatic build queues",
      description: "Defines the eleven build lists applied by Q and the digit hotkeys.",
      remarks: "Q selects list 0; keys 1 through 9 select matching list numbers; key 0 selects list 10. Shift plus a digit applies that list to every owned colony from the colony summary. clear_continuous removes Housing and Trade Goods from the editable queue while preserving a purchased front item.",
      examples: [
        "build_queue 1 = prepend design1 end;",
        "build_queue 9 = housing end;",
      ],
