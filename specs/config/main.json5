    music_enabled: {
      title: "Music enabled",
      description: "Controls whether game music is played.",
      examples: ["music_enabled = true;", "music_enabled = false;"],
      group: "interface",
      type: "bool",
      default: true,
      bind_root: {
        header: "game/mox.h",
        symbol: "MOX::_settings",
      },
      bind: ["music_on"],
    },

    music_volume: {
      title: "Music volume",
      description: "Sets music playback volume as a percentage.",
      examples: ["music_volume = 75;"],
      units: "percent",
      group: "interface",
      type: "int8",
      constraints: {
        min: 0,
        max: 100,
      },
      default: 50,
      bind_root: {
        header: "game/mox.h",
        symbol: "MOX::_settings",
      },
      bind: ["music_level"],
    },

    sound_effects_enabled: {
      title: "Sound effects enabled",
      description: "Controls whether game sound effects are played.",
      examples: ["sound_effects_enabled = true;"],
      group: "interface",
      type: "bool",
      default: true,
      bind_root: {
        header: "game/mox.h",
        symbol: "MOX::_settings",
      },
      bind: ["sound_fx_on"],
    },

    sound_effects_volume: {
      title: "Sound effects volume",
      description: "Sets sound-effect playback volume as a percentage.",
      examples: ["sound_effects_volume = 60;"],
      units: "percent",
      group: "interface",
      type: "int8",
      constraints: {
        min: 0,
        max: 100,
      },
      default: 50,
      bind_root: {
        header: "game/mox.h",
        symbol: "MOX::_settings",
      },
      bind: ["sound_fx_level"],
    },

    autobuild: {
      title: "Experimental autobuild",
      description: "Assigns automatic build queues to individual colonies.",
      examples: ["experiment autobuild enabled = true;", "experiment autobuild default = 0;"],
      group: "gameplay",
      namespace: "experiment",
      type: "autobuild_settings",
      bind_root: { header: "game/build_queue.h", symbol: "BUILD_QUEUE::autobuild_settings" },
      default: { enabled: false, default: 0 },
    },

    board_in_black_hole: {
      title: "Allow boarding in black holes",
      description: "Allows ships affected by a Black Hole Generator to board or be boarded.",
      examples: ["combat board_in_black_hole = false;"],
      group: "gameplay",
      namespace: "combat",
      type: "bool",
      bind_root: {
        header: "game/boarding.h",
        symbol: "BOARDING::_board_in_black_hole",
      },
      default: true,
    },

    enhanced_ux: {
      title: "Experimental UX enhancements",
      description: "Enables interface enhancements not present in the original game, such as click-to-select in the Load Game list.",
      examples: ["enhanced_ux enabled = true;"],
      group: "interface",
      type: "enhanced_ux_settings",
      bind_root: { header: "game/enhanced_ux.h", symbol: "ENHANCED_UX::enhanced_ux_settings" },
      default: { enabled: false },
    },

    fighters_use_point_defense: {
      title: "Fighters use point-defense beams",
      description: "Applies point-defense accuracy and damage modifiers to fighter beam weapons.",
      examples: ["combat fighters_use_point_defense = true;"],
      group: "gameplay",
      namespace: "combat",
      type: "bool",
      bind_root: {
        header: "game/cmbtfire.h",
        symbol: "CMBTFIRE::_fighters_use_point_defense",
      },
      default: false,
    },
  },
}