{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "win32-debug",
      "displayName": "Win32 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${hostSystemName}/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "win32-release",
      "displayName": "Win32 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${hostSystemName}/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "win32-release-pdb",
      "displayName": "Win32 Release + PDB",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${hostSystemName}/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ORION2RE_RELEASE_DEBUG_INFO": "ON"
      },
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "win32-debug-asan",
      "displayName": "Win32 Debug (ASan)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${hostSystemName}/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ORION2RE_ENABLE_ASAN": "ON"
      },
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x86 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${hostSystemName}/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_CXX_FLAGS": "-m32",
        "CMAKE_EXE_LINKER_FLAGS": "-m32",
        "CMAKE_SHARED_LINKER_FLAGS": "-m32",
        "CMAKE_MODULE_LINKER_FLAGS": "-m32",
        "ORION2RE_ENABLE_NETWORKING": "OFF"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux x86 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${hostSystemName}/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_CXX_FLAGS": "-m32",
        "CMAKE_EXE_LINKER_FLAGS": "-m32",
        "CMAKE_SHARED_LINKER_FLAGS": "-m32",
        "CMAKE_MODULE_LINKER_FLAGS": "-m32",
        "ORION2RE_ENABLE_NETWORKING": "OFF"
      }
    },
    {
      "name": "linux-debug-asan",
      "displayName": "Linux x86 Debug (ASan)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${hostSystemName}/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_CXX_FLAGS": "-m32",
        "CMAKE_EXE_LINKER_FLAGS": "-m32",
        "CMAKE_SHARED_LINKER_FLAGS": "-m32",
        "CMAKE_MODULE_LINKER_FLAGS": "-m32",
        "ORION2RE_ENABLE_NETWORKING": "OFF",
        "ORION2RE_ENABLE_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win32-debug",
      "configurePreset": "win32-debug",
      "configuration": "Debug"
    },
    {
      "name": "win32-release",
      "configurePreset": "win32-release",
      "configuration": "Release"
    },
    {
      "name": "win32-release-pdb",
      "configurePreset": "win32-release-pdb",
      "configuration": "Release"
    },
    {
      "name": "win32-debug-asan",
      "configurePreset": "win32-debug-asan",
      "configuration": "Debug"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "configuration": "Debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "configuration": "Release"
    },
    {
      "name": "linux-debug-asan",
      "configurePreset": "linux-debug-asan",
      "configuration": "Debug"
    }
  ]
}